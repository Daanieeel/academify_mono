# Local dev infrastructure only (docker-compose.dev.yml). Apps/packages that
# connect to this Postgres/Redis read their OWN local .env files — see
# apps/worker/.env.example, apps/api-gateway/.env.example,
# packages/database/.env.example, packages/redis/.env.example.
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=educhat
POSTGRES_PORT=5432

REDIS_PORT=6379

# MinIO — reserved for real profile-photo upload (not built yet; AWS later).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001