{
  "name": "edu-chat-platform",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "apps/api-gateway",
    "apps/worker",
    "apps/registry",
    "packages/database",
    "packages/mls",
    "packages/crypto",
    "packages/redis",
    "packages/sync-protocol",
    "packages/auth",
    "packages/env",
    "packages/client-core",
    "packages/config",
    "packages/permissions"
  ],
  "catalog": {
    "@types/bun": "^1.3.14",
    "bullmq": "^5.79.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.11",
    "ioredis": "^5.10.1",
    "typescript": "^6.0.3",
    "zod": "^4.3.6"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@app/api-gateway --filter=@app/worker",
    "dev:all": "turbo run dev --filter=@app/api-gateway --filter=@app/worker --filter=@app/web",
    "prepare": "husky",
    "setup:env": "bun run scripts/setup-env.ts",
    "format": "bunx oxfmt --config packages/config/oxfmt/base.json .",
    "format:check": "bunx oxfmt --config packages/config/oxfmt/base.json --check .",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:ox": "bunx oxlint -c packages/config/oxlint/base.json --import-plugin --promise-plugin --node-plugin --react-plugin --jsx-a11y-plugin --nextjs-plugin --react-perf-plugin --deny-warnings .",
    "lint:fix": "bunx oxlint -c packages/config/oxlint/base.json --import-plugin --promise-plugin --node-plugin --react-plugin --jsx-a11y-plugin --nextjs-plugin --react-perf-plugin --fix .",
    "typecheck": "turbo run typecheck",
    "clear-db": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d && sleep 2 && cd packages/database && bunx drizzle-kit push",
    "seed": "bun run --cwd apps/api-gateway seed"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.26.0",
    "turbo": "latest",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "bunx oxfmt --config packages/config/oxfmt/base.json",
      "bunx oxlint -c packages/config/oxlint/base.json --import-plugin --promise-plugin --node-plugin --react-plugin --jsx-a11y-plugin --nextjs-plugin --react-perf-plugin --fix --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "bun@1.3.5",
  "patchedDependencies": {
    "react-native-css-interop@0.2.3": "patches/react-native-css-interop@0.2.3.patch"
  }
}
