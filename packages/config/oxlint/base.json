{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eqeqeq": "warn",
    "curly": "error",
    "no-console": "off",
    "no-alert": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-duplicate-imports": "error",
    "no-unused-vars": "warn",
    "no-unused-expressions": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "jsx-a11y/no-autofocus": "warn",
    "react/jsx-key": "warn",
    "unicorn/no-empty-file": "off",
    "unicorn/filename-case": "off",
    "unicorn/no-null": "off"
  },
  "settings": {},
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/.next/**",
    "**/.expo/**",
    "**/coverage/**",
    "**/.turbo/**"
  ],
  "env": {
    "builtin": true
  }
}
